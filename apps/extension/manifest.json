{
  "manifest_version": 3,
  "name": "ChatGPT Sync",
  "description": "Local-first backup and assisted restore for ChatGPT Projects.",
  "version": "0.1.0",
  "action": {
    "default_title": "ChatGPT Sync",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
